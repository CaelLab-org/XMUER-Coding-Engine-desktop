{
  "name": "xce-desktop",
  "productName": "XMUER Coding Engine",
  "version": "4.10.0",
  "description": "XMUER Coding Engine desktop app",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "CaelLab",
    "email": "contact@caellab.com"
  },
  "homepage": "https://engine.xmuer.online/",
  "main": "src-main/index.js",
  "private": true,
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "start": "electron .",
    "copy-web": "node scripts/copy-web-build.mjs",
    "pack": "npm run copy-web && electron-builder --win --dir",
    "dist": "npm run pack && node scripts/build-installer.mjs",
    "dist:nsis": "npm run copy-web && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "online.xmuer.engine",
    "productName": "XMUER Coding Engine",
    "copyright": "Copyright (C) 2026 CaelLab — AGPL-3.0-only",
    "artifactName": "XMUER-Coding-Engine-${version}-win-${arch}.${ext}",
    "directories": {
      "buildResources": "art",
      "output": "dist"
    },
    "files": [
      "src-main/**/*",
      "src-preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-build",
        "to": "web"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE.txt",
        "to": "NOTICE.txt"
      },
      {
        "from": "art/privacy-caellab.txt",
        "to": "policies/caellab-privacy.txt"
      },
      {
        "from": "art/privacy-xce.txt",
        "to": "policies/xce-privacy.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "art/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "sb3",
        "name": "Scratch 3 Project",
        "description": "XMUER Coding Engine project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb3"
      },
      {
        "ext": "xce",
        "name": "XMUER Coding Engine Project",
        "description": "XMUER Coding Engine project",
        "role": "Editor",
        "mimeType": "application/x.xce.project"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "XMUER Coding Engine",
      "artifactName": "XCE-Setup-${version}.${ext}",
      "license": "LICENSE",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "uninstallDisplayName": "XMUER Coding Engine ${version}",
      "deleteAppDataOnUninstall": true,
      "menuCategory": "CaelLab"
    }
  }
}
